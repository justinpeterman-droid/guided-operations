{
  "profile": "product-admin",
  "sourceRoots": ["src"],
  "locale": "en-US",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": [
    "Select/Listbox",
    "Date",
    "Form",
    "Scrollbar",
    "Toast",
    "CRUD"
  ],
  "ownership": {
    "Select/Listbox": "native",
    "Date": "native"
  },
  "requiredCommands": ["unit", "e2e", "accessibility", "premium"],
  "commands": {
    "unit": "npm test",
    "e2e": "npm run test:e2e:preview",
    "accessibility": "npm run test:e2e -- tests/e2e/accessibility.spec.ts",
    "premium": "python <frontend-design-premium>/scripts/audit_project.py . --mode strict --no-write"
  },
  "evidence": {
    "crudFullFlow": "tests/e2e/authenticated-admin.spec.ts",
    "failurePaths": "tests/e2e/accessibility.spec.ts"
  }
}
