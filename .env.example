# Public browser-safe Supabase connection values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# Server-only AI provider configuration. Model values are promoted through evals.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_POLICY_MODEL=
OPENAI_REPORT_DRAFT_MODEL=
OPENAI_EMBEDDING_MODEL=
RAG_CORPUS_VERSION=
SAFE_OPERATIONAL_LOGGING_ENABLED=false

# Server-only credential lookup and durable-job secrets.
EMPLOYEE_LOOKUP_PEPPER=
AUTH_DUMMY_ALIAS=
CSRF_HMAC_KEY=
INCIDENT_IDEMPOTENCY_HMAC_KEY=
AUTH_SIGN_IN_ENABLED=false
JOB_WEBHOOK_SECRET=

# Canonical origin for CSRF/origin validation, for example http://localhost:3000.
APP_ENV=development
APP_ORIGIN=
