# Public browser-safe Supabase connection values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase operator credentials. Never prefix these with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY is reserved for narrow provider administration, not routine user traffic.
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# Least-privileged pooled Postgres login used by opaque authentication and the runtime DAL.
# The login is granted membership in guided_operations_preauth and guided_operations_runtime.
APP_DATABASE_URL=

# Server-only authentication secrets. Use independent random values per environment.
EMPLOYEE_LOOKUP_PEPPER=
AUTH_SESSION_HMAC_KEY=
AUTH_DEVICE_HMAC_KEY=
AUTH_NETWORK_HMAC_KEY=
AUTH_CSRF_HMAC_KEY=

# Server-only AI provider configuration. Model values are promoted through evals.
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_GENERATION_MODEL=
AI_EMBEDDING_MODEL=

# Durable-job authentication.
JOB_WEBHOOK_SECRET=

# Canonical origin for CSRF/origin validation, for example http://localhost:3000.
APP_ORIGIN=
