# Public browser-safe Supabase connection values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# Server-only AI provider configuration. Model values are promoted through evals.
AI_PROVIDER=openai
AI_GENERATION_ENABLED=false
AI_MONTHLY_REQUEST_CAP=
AI_BUDGET_STOP_PERCENT=
AI_ACCOUNT_MONTHLY_SHARE_PERCENT=5
AI_ACCOUNT_SHORT_WINDOW_MAX=6
AI_ACCOUNT_CONCURRENCY_MAX=2
AI_REQUEST_LEASE_SECONDS=90
OPENAI_API_KEY=
# Set to exactly `fictional` ONLY while a generated fictional corpus is loaded.
# It waives the provider retention attestation below, because an invented corpus
# has no restricted text to protect. Any other value, including absent, requires
# the full attestation. Setting it against a real corpus is a false declaration.
POLICY_CORPUS_CLASSIFICATION=
OPENAI_DATA_CONTROLS_APPROVAL_REF=
OPENAI_DATA_RETENTION_MODE=
OPENAI_API_DATA_SHARING_ENABLED=false
OPENAI_POLICY_MODEL=
OPENAI_REPORT_DRAFT_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_DIMENSIONS=
POLICY_EMBEDDING_PROFILE_KEY=
RAG_CORPUS_VERSION=
SAFE_OPERATIONAL_LOGGING_ENABLED=false

# Server-only credential lookup and durable-job secrets.
EMPLOYEE_LOOKUP_PEPPER=
AUTH_DUMMY_ALIAS=
CSRF_HMAC_KEY=
# Generate a dedicated 32-byte key and encode it as base64url (43 characters).
AUTH_SESSION_ENCRYPTION_KEY=
INCIDENT_IDEMPOTENCY_HMAC_KEY=
AUTH_SIGN_IN_ENABLED=false
JOB_WEBHOOK_SECRET=

# Canonical origin for CSRF/origin validation, for example http://localhost:3000.
APP_ENV=development
APP_ORIGIN=
