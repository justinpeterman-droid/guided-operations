/node_modules
__pycache__/
*.py[cod]
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# repository-local tool runtimes
/.tools/
/tools/policy-ingestion/.venv/

# private local policy ingestion artifacts
/.policy-ingestion-work/
/policy-ingestion-output/
/tools/policy-ingestion/work/
/tools/policy-ingestion/output/
