/build
/release-evidence/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local Supabase state
/supabase/.branches
/supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts
