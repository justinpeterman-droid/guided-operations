{
  "name": "guided-operations",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:operations",
    "test:operations": "node --test scripts/production-migration-guard.test.mjs scripts/verify-production-migration-history.test.mjs scripts/write-production-migration-evidence.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:check": "node scripts/verify-tracked-secrets.mjs",
    "security:check": "npm run secrets:check && npm audit --omit=dev --audit-level=high",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --level warning --fail-on warning",
    "db:test": "supabase test db --local",
    "db:types:generate": "node scripts/verify-database-types.mjs --write",
    "db:types:check": "node scripts/verify-database-types.mjs",
    "data:inventory:check": "node scripts/verify-production-data-inventory.mjs",
    "recovery:local": "node scripts/rehearse-local-recovery.mjs --confirm-local-guided-operations"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "next": "16.3.2",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "supabase": "2.115.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
